def calculate_grade(percentage):
    """
    Calculate grade based on percentage.
    
    Parameters:
        percentage (float): The percentage/marks
    
    Returns:
        str: The grade (A, B, C, D, or F)
    """
    # Using comparison operators to determine grade
    if percentage >= 80:
        return 'A'
    elif percentage >= 70:
        return 'B'
    elif percentage >= 60:
        return 'C'
    elif percentage >= 50:
        return 'D'
    else:
        return 'F'


def get_result_status(marks):
    """
    Determine pass/fail status based on marks.
    
    Parameters:
        marks (float): Student's marks
    
    Returns:
        str: "PASS" if marks >= 50, else "FAIL"
    """
    if marks >= 50:
        return "PASS"
    else:
        return "FAIL"


def display_student_info(student):
    """
    Display formatted information for a single student.
    
    Parameters:
        student (Student): Student object to display
    """
    percentage, grade = student.get_percentage_and_grade()
    status = student.get_result_status()
    
    print(f"\nStudent: {student.name}")
    print(f"ID: {student.student_id}")
    print(f"Age: {student.age}")
    print(f"Course: {student.course}")
    print(f"Marks: {student.marks}")
    print(f"Percentage: {percentage}%")
    print(f"Grade: {grade}")
    print(f"Status: {status}")


def display_statistics(stats):
    """
    Display formatted class statistics.
    
    Parameters:
        stats (dict): Dictionary containing statistics
    """
    print("\n" + "="*50)
    print("           CLASS STATISTICS")
    print("="*50)
    print(f"Total Students: {stats['total_students']}")
    print(f"Average Marks: {stats['average_marks']:.2f}")
    print(f"Highest Marks: {stats['highest_marks']}")
    print(f"Lowest Marks: {stats['lowest_marks']}")
    print(f"Passing Students: {stats['passing_students']}")
    print(f"Failing Students: {stats['failing_students']}")
    print("="*50)
