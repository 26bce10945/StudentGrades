# utilities.py
# Helper functions for input validation and display

def get_valid_student_id():
    """
    Get a valid student ID from user input.
    Keeps asking until valid integer is provided.
    
    Returns:
        int: Valid student ID
    """
    while True:
        try:
            student_id = input("Enter Student ID: ")
            
            # Type conversion: convert string to integer
            student_id = int(student_id)
            
            # Validation: ID should be positive
            if student_id > 0:
                return student_id
            else:
                print("❌ Student ID must be a positive number. Try again.")
        except ValueError:
            # Exception handling: input was not a valid integer
            print("❌ Invalid input. Please enter a valid number.")


def get_valid_name():
    """
    Get a valid student name from user input.
    Ensures name is not empty.
    
    Returns:
        str: Valid student name
    """
    while True:
        name = input("Enter Name: ")
        
        # Validation: name should not be empty and should contain only letters and spaces
        if len(name.strip()) > 0 and all(c.isalpha() or c.isspace() for c in name):
            return name
        else:
            print("❌ Name cannot be empty and should contain only letters. Try again.")


def get_valid_age():
    """
    Get a valid student age from user input.
    Age should be between 15 and 25 (typical student age).
    
    Returns:
        int: Valid age
    """
    while True:
        try:
            age = input("Enter Age: ")
            age = int(age)  # Type conversion
            
            # Validation using comparison operators
            if 15 <= age <= 25:
                return age
            else:
                print("❌ Age must be between 15 and 25. Try again.")
        except ValueError:
            print("❌ Invalid input. Please enter a valid number.")


def get_valid_marks():
    """
    Get valid marks from user input.
    Marks should be between 0 and 100.
    
    Returns:
        float: Valid marks
    """
    while True:
        try:
            marks = input("Enter Marks (0-100): ")
            marks = float(marks)  # Type conversion to float
            
            # Validation using comparison operators
            if 0 <= marks <= 100:
                return marks
            else:
                print("❌ Marks must be between 0 and 100. Try again.")
        except ValueError:
            print("❌ Invalid input. Please enter a valid number.")


def get_valid_course():
    """
    Get a valid course name from user input.
    
    Returns:
        str: Valid course name
    """
    while True:
        course = input("Enter Course: ")
        
        # Validation: course should not be empty
        if len(course.strip()) > 0:
            return course
        else:
            print("❌ Course cannot be empty. Try again.")


def get_valid_menu_choice():
    """
    Get a valid menu choice from user input.
    Should be between 1 and 8.
    
    Returns:
        int: Valid menu choice
    """
    while True:
        try:
            choice = input("\nEnter your choice (1-8): ")
            choice = int(choice)  # Type conversion
            
            # Validation using comparison and logical operators
            if 1 <= choice <= 8:
                return choice
            else:
                print("❌ Please enter a number between 1 and 8.")
        except ValueError:
            print("❌ Invalid input. Please enter a valid number.")


def get_valid_search_choice():
    """
    Get search preference (by ID or name).
    
    Returns:
        str: Either "id" or "name"
    """
    while True:
        choice = input("Search by (1) ID or (2) Name? Enter 1 or 2: ")
        
        if choice == "1":
            return "id"
        elif choice == "2":
            return "name"
        else:
            print("❌ Please enter 1 or 2.")


